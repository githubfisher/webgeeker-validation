{
    "name": "ghf/webgeeker-validation",
    "description": "Validation for WebGeeker (fork of photondragon/webgeeker-validation, PHP 8.4/8.5 support)",
    "license": "MIT",
    "authors": [
        {
            "name": "photondragon",
            "email": "photondragon@163.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "WebGeeker\\Validation\\": "src/Validation/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebGeeker\\ValidationTest\\": "tests/Validation/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^5.6 || ^7.0 || ^8.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7 || ^6.5 || ^7.5 || ^8.5 || ^9.6"
    }
}
